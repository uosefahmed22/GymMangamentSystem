{
  "MailSettings": {
    "Port": 587,
    "SmtpServer": "smtp.example.com",
    "Email": "YOUR_SMTP_EMAIL",
    "DisplayedName": "GymManagementSystem",
    "Password": "YOUR_SMTP_PASSWORD"
  },
  "CloudinarySetting": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "JWT": {
    "Key": "YOUR_JWT_SECRET_AT_LEAST_32_CHARACTERS",
    "ValidIssuer": "YOUR_JWT_ISSUER",
    "ValidAudience": "YOUR_JWT_AUDIENCE",
    "DurationInDays": "30"
  },
  "ConnectionStrings": {
    "DefaultConnections": "Server=YOUR_DB_HOST;Database=YOUR_DB_NAME;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True"
  },
  "AllowedHosts": "*"
}
